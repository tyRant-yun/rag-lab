# Runtime configuration for the private RAG Lab container or local server.
# Do not use unlicensed textbook PDFs or their derived chunks in a public deployment.
RAG_CHUNKS_PATH=/data/chunks.jsonl
RAG_COLLECTION=replace_with_a_new_or_verified_collection
RAG_BIND_HOST=0.0.0.0
RAG_PORT=8000
RAG_QDRANT_URL=http://qdrant:6333
RAG_OLLAMA_HOST=http://ollama:11434
RAG_OLLAMA_MODEL=qwen3-embedding:0.6b
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_QDRANT_TIMEOUT_SECONDS=10
RAG_ENABLE_DEBUG_ROUTES=false
